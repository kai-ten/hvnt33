# The built-in database (npm run setup installs it) uses this password.
ARCADEDB_PASSWORD=replace-with-a-long-random-password
ARCADEDB_DATABASE=newsroom
PORT=4310
# Optional: your own ArcadeDB instead of the built-in one.
# ARCADEDB_URL=http://127.0.0.1:2480
# ARCADEDB_USER=root
# Optional: enables user-triggered in-app AI analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Optional: enables "Archive now" (Wayback Machine Save Page Now).
# Free keys from https://archive.org/account/s3.php
ARCHIVE_ORG_ACCESS_KEY=
ARCHIVE_ORG_SECRET_KEY=
