    "test": "vitest run",
    "verify": "npm run typecheck && npm test && node scripts/build.ts",
    "e2e": "node scripts/e2e.mjs",
    "package": "node scripts/package.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@hvnt33/ui": "*",
    "@types/node": "26.6.2",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "productName": "HVNT33",
  "author": "hvnt33 contributors",
  "homepage": "https://hvnt33.com"
}
