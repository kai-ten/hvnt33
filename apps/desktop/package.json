{
  "name": "@hvnt33/desktop",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "hvnt33: search engines, a capture-enabled browser, the live case and an agent terminal in one window, with the database built in. Electron shell around @hvnt33/ui.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.ts",
    "app": "node scripts/build.ts && electron .",
