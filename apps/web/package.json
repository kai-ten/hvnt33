{
  "name": "@hvnt33/web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "hvnt33.com: the landing page, features, getting started and the manual.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run images && next build --webpack && node scripts/csp.ts",
    "images": "node scripts/images.ts",
    "serve": "node scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:content": "node scripts/content-lint.ts",
    "test": "playwright test",
    "shots": "node scripts/shots.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm run lint:content && npm test && npm audit --omit=dev --audit-level=moderate && npm audit signatures",
    "newsletter": "node --env-file-if-exists=.env.local scripts/newsletter.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "hast-util-from-html": "2.0.3",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@shikijs/rehype": "4.4.3",
    "hast-util-to-string": "3.0.1",
    "mdast-util-to-string": "4.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
}
