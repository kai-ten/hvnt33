# The Investigations newsletter. Copy to .env.local for local sending and testing,
# and set the same variables in the Vercel project (Settings, Environment Variables).
RESEND_API_KEY=re_...
# Resend, Audience, Segments: the segment subscribers are added to.
RESEND_SEGMENT_ID=
# A sender on a domain verified in Resend.
NEWSLETTER_FROM="HVNT33 Investigations <investigations@hvnt33.com>"
# Any long random string: signs the confirmation links. Generate one with: openssl rand -base64 32
NEWSLETTER_SECRET=
SITE_URL=https://hvnt33.com

# Public links shown on the Cloud and Community pages when they are ready.
NEXT_PUBLIC_FOUNDING_CHECKOUT_URL=
NEXT_PUBLIC_DISCORD_URL=
